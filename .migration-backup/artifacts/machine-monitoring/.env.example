# PostgreSQL connection string from Neon or another PostgreSQL provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# A random secret with at least 32 characters. Do not commit the real value.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Used only by the local seed command to create the first staff account.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters